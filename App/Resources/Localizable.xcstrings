    "If the switch is on but access is still blocked, remove TypoBouncer from the permission list and add this copy again. A development update can leave an older permission behind.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the switch is on but access is still blocked, remove TypoBouncer from the permission list and add this copy again. A development update can leave an older permission behind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
